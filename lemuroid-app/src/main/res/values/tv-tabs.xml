<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="tv_top_bar_height">80dp</dimen>
    <dimen name="tv_top_bar_top_padding">0dp</dimen>
    <dimen name="tv_top_bar_horizontal_padding">48dp</dimen>
    <!-- Logo of the app on the right of the tabs bar. -->
    <dimen name="tv_app_logo_height">24dp</dimen>
    <dimen name="tv_tab_horizontal_padding">20dp</dimen>
    <dimen name="tv_tab_vertical_padding">8dp</dimen>
    <dimen name="tv_tab_spacing">8dp</dimen>
    <dimen name="tv_tab_corner_radius">20dp</dimen>
    <dimen name="tv_systems_grid_top_padding">24dp</dimen>
    <!-- Same corner radius as the mobile cards (Material 3 medium shape). -->
    <dimen name="tv_card_corner_radius">12dp</dimen>
    <dimen name="tv_card_focus_stroke">3dp</dimen>
    <dimen name="tv_empty_library_width">520dp</dimen>
    <dimen name="tv_empty_library_padding">24dp</dimen>
    <dimen name="tv_empty_library_spacing">16dp</dimen>
    <dimen name="tv_progress_bar_height">8dp</dimen>
    <dimen name="tv_progress_bar_corner_radius">4dp</dimen>
    <!-- The games of a system are shown below the tabs bar: title band right below it, then the grid, which
         leaves some room for the zoom of the focused cards of the first row. -->
    <dimen name="tv_grid_title_height">48dp</dimen>
    <dimen name="tv_grid_title_elevation">24dp</dimen>
    <dimen name="tv_games_grid_top_padding">72dp</dimen>
    <!-- Side margins of the content of every tab, as in the Android TV guidelines (58dp on a 960dp wide screen):
         the content is the screen width minus both margins (TVHomeFragment.contentWidth). -->
    <dimen name="tv_content_side_margin">58dp</dimen>
    <!-- Grids of square cards (games of a system, favorites, consoles): 5 per row fill the content width. -->
    <integer name="tv_home_cards_per_row">5</integer>
    <dimen name="tv_home_card_spacing">12dp</dimen>
    <!-- Between the rows of the grids of games: room for the zoom of the focused card (1.1), so a tall cover never
         covers the row below. -->
    <dimen name="tv_games_grid_row_spacing">20dp</dimen>
    <!-- Home rows: 16:9 cards (about 153 x 86dp on a 960dp wide screen), 5 of them fill the content width, with the
         spacing of the immersive list guidelines. Covers of other shapes are shown whole inside them. -->
    <integer name="tv_home_row_cards">5</integer>
    <dimen name="tv_home_row_card_spacing">20dp</dimen>
    <!-- Room on both sides of the rows for the zoom of the focused card; nothing else is drawn there. -->
    <dimen name="tv_home_row_edge">12dp</dimen>
    <!-- Immersive list on top of the home screen, with the measures of the Android TV guidelines: screenshot of the
         focused game in the top right corner (16:9, 758 x 426dp), system, title and description on the left, 40dp
         above the row of cards. Offsets are from the top of the tabs content (below the 80dp tabs bar). -->
    <dimen name="tv_backdrop_width">758dp</dimen>
    <dimen name="tv_backdrop_height">426dp</dimen>
    <dimen name="tv_immersive_info_width">485dp</dimen>
    <!-- Space between the description of the immersive list and its cards. -->
    <dimen name="tv_immersive_info_gap">30dp</dimen>
    <!-- Position of the cards of the immersive list (295dp from the top of the screen): their square cells (about
         153dp), names and focus zoom fit above the bottom of the screen, also with tall covers, and the title of
         "Continue playing" stays just below the screen (higher, its letters peek out cut). Its texts end
         tv_immersive_info_gap above it, at 185dp (the height of their container is this minus that gap).
         Like the next one, it is the position of the cards: the title of a row goes above it. -->
    <dimen name="tv_immersive_row_top">215dp</dimen>
    <!-- Other home rows, while they have the focus and the immersive list is collapsed: room for their title above,
         with the previous row fully out of the screen (its bottom edge must not show under the tabs bar). -->
    <dimen name="tv_home_rows_top">46dp</dimen>
    <dimen name="tv_immersive_title_size">32sp</dimen>
    <!-- Logo of the game in place of the title (scaled down keeping its shape). -->
    <dimen name="tv_immersive_logo_max_width">360dp</dimen>
    <dimen name="tv_immersive_logo_max_height">72dp</dimen>
    <dimen name="tv_immersive_meta_size">12sp</dimen>
    <dimen name="tv_immersive_description_size">16sp</dimen>
    <!-- Tabs: the pill slides to the selected tab and the content slides in from that side. -->
    <integer name="tv_tab_animation_duration">280</integer>
    <!-- Opening and closing the details of a game. -->
    <integer name="tv_details_fade_duration">300</integer>
    <!-- Alphabet bar on the right of the games of a console, outside the content width: inside the 58dp side
         margin, 9dp from the screen edge and from the grid. -->
    <integer name="tv_alphabet_min_games">13</integer>
    <dimen name="tv_alphabet_width">40dp</dimen>
    <dimen name="tv_alphabet_end_margin">9dp</dimen>
    <dimen name="tv_alphabet_top_margin">56dp</dimen>
    <dimen name="tv_alphabet_bottom_margin">16dp</dimen>
    <dimen name="tv_alphabet_vertical_padding">8dp</dimen>
    <dimen name="tv_alphabet_highlight_width">26dp</dimen>
    <dimen name="tv_alphabet_text_size">12sp</dimen>
    <dimen name="tv_alphabet_letter_size">110dp</dimen>
    <dimen name="tv_alphabet_letter_corner_radius">20dp</dimen>
    <dimen name="tv_alphabet_letter_text_size">64sp</dimen>
    <dimen name="tv_alphabet_target_stroke">2dp</dimen>

    <style name="TVHomeRowsOverlay" parent="">
        <item name="browsePaddingStart">@dimen/tv_home_row_edge</item>
        <item name="browsePaddingEnd">@dimen/tv_home_row_edge</item>
    </style>


    <!-- Like Google TV: the focused tab is a white pill with dark text, the rest of the tabs use white text. -->
    <!-- Bottom of the game cards (name and subtitle): the light tone behind the images of the consoles. -->
    <color name="tv_card_info_background">@color/md_theme_dark_surfaceContainerHigh</color>
    <color name="tv_tab_focused_background">@android:color/white</color>
    <!-- Accent of the TV buttons and search: the soft green of the selected tab instead of the bright primary. -->
    <color name="tv_alphabet_unavailable">#4C5249</color>
    <color name="tv_alphabet_letter_background">#EB3A4B39</color>
    <color name="tv_accent">@color/md_theme_dark_secondaryContainer</color>
    <!-- Selected tab while the bar has no focus: the almost grey tone of the logo green with white text. -->
    <color name="tv_tab_selected_background">@color/playretro_soft_green</color>
    <color name="tv_tab_focused_text">@color/md_theme_dark_background</color>
    <color name="tv_tab_selected_text">@color/playretro_on_soft_green</color>
    <color name="tv_tab_default_text">@android:color/white</color>

    <style name="GameStationTVTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/tv_tab_spacing</item>
        <item name="android:layout_marginEnd">@dimen/tv_tab_spacing</item>
        <item name="android:paddingStart">@dimen/tv_tab_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/tv_tab_horizontal_padding</item>
        <item name="android:paddingTop">@dimen/tv_tab_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/tv_tab_vertical_padding</item>
        <!-- No background: the pill behind the tabs slides to the selected one (TVMainTabsFragment), which also
             sets the text color of the tab over it. -->
        <item name="android:textColor">@color/tv_tab_default_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
