<?xml version="1.0" encoding="utf-8"?>
<androidx.leanback.widget.BrowseFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_tabs_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/leanback_background"
    android:clipChildren="false">

    <!-- Screenshot of the focused game of the home screen (immersive list), behind the tabs bar and the rows. -->
    <com.swordfish.lemuroid.app.tv.home.TVBackdropView
        android:id="@+id/tv_backdrop"
        android:layout_width="@dimen/tv_backdrop_width"
        android:layout_height="@dimen/tv_backdrop_height"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no" />

    <!-- Clipping is disabled so the search orb is not cut when it grows on focus. -->
    <FrameLayout
        android:id="@+id/tv_top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_top_bar_height"
        android:background="@color/leanback_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/tv_top_bar_horizontal_padding"
        android:paddingTop="@dimen/tv_top_bar_top_padding"
        android:paddingEnd="@dimen/tv_top_bar_horizontal_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.leanback.widget.SearchOrbView
                android:id="@+id/tv_search_orb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <!-- Syncs the saves now; only shown when the sync is configured. -->
            <androidx.leanback.widget.SearchOrbView
                android:id="@+id/tv_sync_orb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:clipChildren="false"
                android:contentDescription="@string/settings_save_sync_refresh"
                android:visibility="gone" />

        </LinearLayout>

        <!-- The pill of the selected tab is a view of its own behind the tabs, so it can slide from one to another. -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:id="@+id/tv_tab_pill"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/tv_tab_pill" />

            <LinearLayout
                android:id="@+id/tv_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_tab_home"
                    style="@style/GameStationTVTab"
                    android:text="@string/title_home" />

                <TextView
                    android:id="@+id/tv_tab_systems"
                    style="@style/GameStationTVTab"
                    android:text="@string/title_consoles" />

                <TextView
                    android:id="@+id/tv_tab_settings"
                    style="@style/GameStationTVTab"
                    android:text="@string/title_settings" />

                <TextView
                    android:id="@+id/tv_tab_about"
                    style="@style/GameStationTVTab"
                    android:text="@string/title_about" />

            </LinearLayout>

        </FrameLayout>

        <!-- Logo of the app, white and tinted with the bright green of the app icon (android:tint: app:tint is
             ignored by a plain ImageView). -->
        <ImageView
            android:id="@+id/tv_app_name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/tv_app_logo_height"
            android:layout_gravity="end|center_vertical"
            android:adjustViewBounds="true"
            android:contentDescription="@string/lemuroid_name"
            android:src="@drawable/playretro_logo"
            android:tint="@color/playretro_brand_green" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/tv_tab_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/tv_top_bar_height" />

</androidx.leanback.widget.BrowseFrameLayout>
