<?xml version="1.0" encoding="utf-8"?>
<!-- Backups and transfers from Android 12: the same as backup_rules.xml (network share settings left out). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="smb_config.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="smb_config.xml" />
    </device-transfer>
</data-extraction-rules>
